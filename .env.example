# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# SRS
SRS_API_BASE_URL=http://your-mediamtx-host:1985

# Server
PORT=3000
HOST=0.0.0.0

# Polling
POLLING_INTERVAL_MS=500

# Logging
LOG_LEVEL=info

# This server's public URL (used in SRS config generation)
PUBLIC_URL=http://your-server-host:3000
